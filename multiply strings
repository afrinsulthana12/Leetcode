class Solution {
    public String multiply(String num1, String num2) {
        if (num1.equals("0") || num2.equals("0")) return "0";

        int n1 = num1.length(), n2 = num2.length();
        int[] res = new int[n1 + n2];

        // Multiply each digit and add to the corresponding position in res
        for (int i = n1 - 1; i >= 0; i--) {
            for (int j = n2 - 1; j >= 0; j--) {
                int mul = (num1.charAt(i) - '0') * (num2.charAt(j) - '0');
                int sum = mul + res[i + j + 1];

                res[i + j + 1] = sum % 10; // Units place
                res[i + j] += sum / 10;    // Carry to the next place
            }
        }

        // Convert the integer array back to a string
        StringBuilder sb = new StringBuilder();
        for (int p : res) {
            if (!(sb.length() == 0 && p == 0)) { // Skip leading zeros
                sb.append(p);
            }
        }

        return sb.toString();
    }
}
