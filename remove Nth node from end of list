class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        // Create a dummy node to handle edge cases like removing the head
        ListNode dummy = new ListNode(0);
        dummy.next = head;
        
        ListNode fast = dummy;
        ListNode slow = dummy;
        
        // 1. Move the fast pointer n steps ahead
        for (int i = 0; i <= n; i++) {
            fast = fast.next;
        }
        
        // 2. Move both pointers until fast reaches the end
        // The gap between slow and fast is now n nodes
        while (fast != null) {
            fast = fast.next;
            slow = slow.next;
        }
        
        // 3. slow.next is the node to be deleted
        slow.next = slow.next.next;
        
        return dummy.next;
    }
}
