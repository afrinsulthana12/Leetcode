class Solution {
public:
    bool isValidSudoku(vector<vector<char>>& board) {
        bool row[9][9] = {false}, col[9][9] = {false}, box[9][9] = {false};

        for (int r = 0; r < 9; ++r) {
            for (int c = 0; c < 9; ++c) {
                if (board[r][c] == '.') continue;
                int num = board[r][c] - '1';
                int k = (r / 3) * 3 + (c / 3);
                if (row[r][num] || col[c][num] || box[k][num]) return false;
                row[r][num] = col[c][num] = box[k][num] = true;
            }
        }
        return true;
    }
};
