import java.util.*;

class Solution {
    public List<List<String>> groupAnagrams(String[] strs) {
        if (strs == null || strs.length == 0) return new ArrayList<>();
        
        // Map to store the signature of the anagram as the key
        Map<String, List<String>> map = new HashMap<>();
        
        for (String s : strs) {
            // Create a frequency array for characters 'a' through 'z'
            int[] count = new int[26];
            for (char c : s.toCharArray()) {
                count[c - 'a']++;
            }
            
            // Build a unique string key from the frequency array
            // Example: "eat" becomes "1#1#0#0#1#..." (one 'a', one 'e', one 't')
            StringBuilder sb = new StringBuilder();
            for (int i : count) {
                sb.append('#'); // Delimiter to prevent collision (e.g., 1, 11 vs 11, 1)
                sb.append(i);
            }
            
            String key = sb.toString();
            
            // If key isn't in map, add a new list; then add the original string
            map.putIfAbsent(key, new ArrayList<>());
            map.get(key).add(s);
        }
        
        return new ArrayList<>(map.values());
    }
}
